{
  "name": "weather-schedule-app",
  "description": "Android weather and schedule app foundation",
  "license": "0BSD",
  "version": "0.1.0",
  "main": "index.ts",
  "dependencies": {
    "@capacitor/android": "^8.6.3",
    "@capacitor/core": "^8.6.3",
    "@expo/metro-runtime": "~58.0.17",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@supabase/supabase-js": "^2.119.2",
    "expo": "~58.0.25",
    "expo-asset": "~58.0.21",
    "expo-audio": "~58.0.12",
    "expo-blur": "~58.0.6",
    "expo-font": "~58.0.12",
    "expo-location": "~58.0.22",
    "expo-status-bar": "~58.0.5",
    "expo-video": "~58.0.14",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-svg": "^15.16.0",
    "react-native-web": "~0.21.4"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.3",
    "@types/react": "~19.3.0",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "setup:supabase": "node scripts/setup-supabase.mjs",
    "android": "expo start --android",
    "typecheck": "tsc --noEmit",
    "export:android": "expo export --platform android",
    "web": "expo start --web",
    "test": "node --test tests/*.test.mjs",
    "typecheck:server": "tsc -p server/tsconfig.json",
    "test:avatar": "node --test tests/avatar*.test.mjs",
    "build:web:local": "expo export --platform web --max-workers 2 && node scripts/web-policy.mjs",
    "build:web:pages": "ALLIT_PAGES_BUILD=1 EXPO_PUBLIC_ALLIT_ACCOUNT_REQUIRED=1 npm run build:web:local",
    "build:web:release": "node scripts/build-release.mjs pages",
    "android:sync": "npm run build:web:local && cap sync android",
    "android:sync:release": "node scripts/build-release.mjs android",
    "android:live": "ALLIT_ANDROID_MODE=live cap sync android",
    "android:pages": "ALLIT_ANDROID_MODE=pages cap sync android"
  },
  "private": true
}
