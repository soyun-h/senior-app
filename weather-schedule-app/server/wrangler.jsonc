{
  "name": "weather-schedule-kma",
  "main": "worker.ts",
  "compatibility_date": "2026-11-17",
  "workers_dev": true,
  "observability": { "enabled": false },
  "vars": {
    "ALLOWED_ORIGINS": "https://localhost,http://localhost:8080,http://localhost:8081,http://localhost:8090",
    "DAILY_UPSTREAM_LIMIT": "800"
  },
  "durable_objects": { "bindings": [{ "name": "WEATHER_GATEWAY", "class_name": "WeatherGateway" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["WeatherGateway"] }]
}
